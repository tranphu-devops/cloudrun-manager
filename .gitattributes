# Chuẩn hoá line ending. Repo này sẽ được sửa trên Windows (OneDrive) nên nếu không
# khai báo, git sẽ có lúc thấy "cả file thay đổi" chỉ vì CRLF/LF.
* text=auto eol=lf

# Script Windows phải giữ CRLF mới chạy đúng.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary — đừng convert, đừng diff.
*.png  binary
*.ico  binary
*.icns binary
*.jpg  binary
*.woff binary
*.woff2 binary

# Lockfile: đánh dấu generated để review khỏi bị ngập diff.
package-lock.json  -diff linguist-generated
Cargo.lock         -diff linguist-generated
